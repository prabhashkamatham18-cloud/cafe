# Local Qwen 2.5 through Ollama (no API key required).
# Install/start Ollama and make sure the model is available: ollama pull qwen2.5:latest
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# Optional OpenAI provider instead:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_private_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Never commit or share your .env file.
